---
// src/components/vbk/pages/ResultadosPage.astro
// /resultados: hero full-bleed con crossfade (2 fotos), barra de aviso con
// badge "DATOS DE PRUEBA" y tablero XCO/XCC con tabs, chips de categoría,
// tabla con renumeración y footer de tablero. Filas renderizadas
// server-side desde la colección pagesResultados (porte SSG del
// renderResultsTable original). Fuente: resultados.html + script.js.
//
// Visibilidad: mientras "Publicar resultados" (Keystatic → Ajustes del sitio)
// esté desmarcado, la página muestra solo el aviso de espera (pending.* de la
// entrada), con noindex y sin tablero. Ver src/lib/results.ts.

import Img from '@/components/vbk/Img.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { defaultLocale, localePath, type Locale } from '@/i18n/config';
import { areResultsPublished } from '@/lib/results';
import { REGISTRATION_URL } from '@/data/site';

export interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;

// Contenido de /resultados desde la colección Keystatic `pagesResultados`
// (src/content/pages/resultados/{locale}.json): copy del hero/aviso/tablero
// y las filas del tablero (datos de prueba hasta la fuente oficial de
// cronometraje — warning del site-spec).
const resultadosEntry = await getEntry('pagesResultados', locale);
if (!resultadosEntry) {
  throw new Error(`[pagesResultados] No existe la entrada '${locale}' (src/content/pages/resultados/${locale}.json). Edítala en el CMS (Keystatic → Resultados).`);
}
const t = resultadosEntry.data;

const published = await areResultsPublished();
const settingsEntry = await getEntry('siteSettings', 'index');
const registrationUrl = settingsEntry?.data.registrationUrl ?? REGISTRATION_URL;

// Chips de categoría: 'Todas' + las categorías editables (slug ↔ etiqueta)
const chips: Array<{ slug: string; label: string }> = [
  { slug: 'all', label: t.chipAll },
  ...t.categories.map((category) => ({ slug: category.slug, label: category.label })),
];

const panels = [
  { id: 'xco' as const, label: 'XCO', rows: t.xcoRows },
  { id: 'xcc' as const, label: 'XCC', rows: t.xccRows },
];
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/resultados"
  locale={locale}
  noindex={!published}
>
  <div class="site-shell">
    <div class="results-page">
      <section class:list={['results-hero', !published && 'results-hero--pending']}>
        <div class="results-hero-bg" data-crossfade data-interval="8000" aria-hidden="true">
          <Img class="carousel-img active" src="/img/resultados_mujer.avif" alt="" priority widths={[480, 768, 1024, 1440, 1920]} />
          <Img class="carousel-img" src="/img/resultados_hombre.avif" alt="" widths={[480, 768, 1024, 1440, 1920]} />
        </div>
        <div class="results-hero-overlay"></div>
        {published ? (
          <div class="inner-intro">
            <p class="section-kicker">{t.hero.kicker}</p>
            <h1 set:html={t.hero.headingHtml} />
            <p>{t.hero.intro}</p>
          </div>
        ) : (
          <div class="inner-intro">
            <p class="section-kicker">{t.pending.kicker}</p>
            <h1 set:html={t.pending.headingHtml} />
            <p class="results-pending-intro">{t.pending.intro}</p>
            <div class="hero-actions">
              <a class="button button-lime" href={registrationUrl} target="_blank" rel="noopener" data-registration>
                {t.pending.primaryCta} <span aria-hidden="true">&#x2197;&#xFE0E;</span>
              </a>
              <a class="text-link" href={localePath(locale, '/ruta')}>
                {t.pending.secondaryCta} <span aria-hidden="true">&#x2192;&#xFE0E;</span>
              </a>
            </div>
          </div>
        )}
      </section>

      {published && (

      <section class="results-content">
        <div class="results-note-bar">
          <span class="results-demo-badge">{t.demoBadge}</span>
          <p class="results-demo-note">{t.demoNote}</p>
        </div>

        <div class="results-board-wrap">
          <div class="results-board-head">
            <span>{t.boardHeadLeft}</span>
            <span>{t.boardHeadRight}</span>
          </div>

          <div class="results-tabs" role="tablist" aria-label={t.tabsLabel}>
            {panels.map((panel, index) => (
              <button
                class:list={['results-tab', index === 0 && 'is-active']}
                type="button"
                role="tab"
                id={`results-tab-${panel.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`results-panel-${panel.id}`}
              >
                {panel.label}
              </button>
            ))}
          </div>

          <div class="results-chips" role="group" aria-label={t.chipsLabel}>
            {chips.map((chip, index) => (
              <button
                class:list={['results-chip', index === 0 && 'is-active']}
                type="button"
                data-category={chip.slug}
              >
                {chip.label}
              </button>
            ))}
          </div>

          <!-- DATOS DE PRUEBA: reemplazar por fuente oficial de cronometraje -->
          <div class="results-panels is-demo">
            {panels.map((panel, index) => (
              <div
                class:list={['results-panel', index === 0 && 'is-active']}
                role="tabpanel"
                id={`results-panel-${panel.id}`}
                aria-labelledby={`results-tab-${panel.id}`}
                hidden={index !== 0}
              >
                <div class="results-table-wrap">
                  <table class="results-table">
                    <thead>
                      <tr>
                        {t.columns.map((column) => (
                          <th scope="col">{column}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {panel.rows.map((row) => (
                        <tr
                          data-category={row.cat}
                          data-podium={row.pos === 1 ? '1' : undefined}
                        >
                          <td>{row.pos}</td>
                          <td>{row.dorsal}</td>
                          <td>{row.name}</td>
                          <td>{row.club}</td>
                          <td>{row.catLabel}</td>
                          <td>{row.time}</td>
                          <td>{row.dif}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>

          <div class="results-board-foot">
            {t.boardFoot.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      </section>
      )}
    </div>
  </div>
</BaseLayout>
