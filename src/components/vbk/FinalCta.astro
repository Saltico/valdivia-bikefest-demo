---
// src/components/vbk/FinalCta.astro
// CTA final compartido (home, evento, ruta): fondo brand #4C6444 (aprobado
// en site-spec.json), <em> en ink, CTA Inscríbete externa + link Contacto.

import { REGISTRATION_URL } from '@/data/site';
import { getEntry } from 'astro:content';
import { defaultLocale, localePath, type Locale } from '@/i18n/config';

export interface Props {
  locale?: Locale;
  /** id del section (ancla). Solo la home lo usa ('contacto'). */
  sectionId?: string;
}

const { locale = defaultLocale, sectionId } = Astro.props;

// Textos compartidos + ajustes desde Keystatic (colecciones siteCommon/siteSettings)
const commonEntry = await getEntry('siteCommon', locale);
if (!commonEntry) {
  throw new Error(`[siteCommon] No existe la entrada '${locale}' (src/content/common/${locale}.json).`);
}
const common = commonEntry.data;
const cta = common.finalCta;

// URL de inscripción editable vía CMS; fallback al valor por defecto de site.ts
const settingsEntry = await getEntry('siteSettings', 'index');
const registrationUrl = settingsEntry?.data.registrationUrl ?? REGISTRATION_URL;
---

<section class="final-cta" id={sectionId} aria-labelledby="final-cta-title">
  <div class="final-cta-inner">
    <div class="cta-coordinate">{cta.coordinate}</div>
    <div>
      <p class="section-kicker">{cta.kicker}</p>
      <h2 id="final-cta-title" set:html={cta.headingHtml} />
    </div>
    <div class="cta-actions">
      <a
        class="button button-lime"
        href={registrationUrl}
        target="_blank"
        rel="noopener"
        data-registration
      >
        {cta.primaryLabel} <span aria-hidden="true">&#x2197;&#xFE0E;</span>
      </a>
      <a class="text-link text-link-light" href={localePath(locale, cta.secondaryHref)}>
        {cta.secondaryLabel} <span aria-hidden="true">&#x2197;&#xFE0E;</span>
      </a>
    </div>
  </div>
</section>
