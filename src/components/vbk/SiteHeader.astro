---
// src/components/vbk/SiteHeader.astro
// Header fijo transparente que se solidifica al hacer scroll (JS global).
// Logo invertido a la izquierda, nav central, switcher ES/EN (enlace real a
// la misma página en el otro locale), CTA Inscríbete y menú móvil con
// focus trap. Mobile: CTA de inscripción a ancho completo.

import { siteBrand, REGISTRATION_URL } from '@/data/site';
import { commonCopy } from '@/i18n/common';
import { defaultLocale, localePath, alternateLocalePath, type Locale } from '@/i18n/config';

export interface Props {
  locale?: Locale;
  /** Path sin prefijo de locale (p. ej. '/evento') */
  path?: string;
}

const { locale = defaultLocale, path = '/' } = Astro.props;
const common = commonCopy[locale];

const navItems = common.nav.map((item) => ({
  ...item,
  href: localePath(locale, item.href),
}));

const altLocale: Locale = locale === 'es' ? 'en' : 'es';
const altHref = alternateLocalePath(locale, path);
const altLabel = altLocale.toUpperCase();
---

<header class="site-header">
  <a class="wordmark" href={localePath(locale, '/')} aria-label={common.homeLabel}>
    <img
      class="wordmark-logo"
      src={siteBrand.logoUrl}
      alt={siteBrand.name}
      width={siteBrand.logoWidth}
      height={siteBrand.logoHeight}
    />
  </a>

  <nav class="main-nav" aria-label={common.mainNavLabel}>
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="header-actions">
    <a
      class="language-toggle"
      href={altHref}
      hreflang={altLocale}
      aria-label={common.changeLanguage}
      data-language-toggle
    >
      <span data-language-label>{altLabel}</span>
      <span class="language-dot"></span>
    </a>
    <a
      class="button button-small button-lime"
      href={REGISTRATION_URL}
      target="_blank"
      rel="noopener"
      data-registration
    >
      {common.register} <span aria-hidden="true">&#x2197;&#xFE0E;</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={common.openMenu}
      data-menu-open-label={common.openMenu}
      data-menu-close-label={common.closeMenu}
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label={common.mobileNavLabel}>
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a
    class="button button-lime"
    href={REGISTRATION_URL}
    target="_blank"
    rel="noopener"
    data-registration
  >
    {common.register} <span aria-hidden="true">&#x2197;&#xFE0E;</span>
  </a>
</div>
<div class="menu-backdrop"></div>
