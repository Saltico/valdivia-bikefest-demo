---
// src/components/vbk/SiteFooter.astro
// Footer unificado (bug fix del original): mismas 5 secciones en todas las
// páginas — Evento, Ruta y horario, Resultados, Valdivia, Contacto.

import { withBase } from '@/utils/url';
import { siteBrand } from '@/data/site';
import { getEntry } from 'astro:content';
import { defaultLocale, localePath, type Locale } from '@/i18n/config';

export interface Props {
  locale?: Locale;
  /** Muestra el botón de preferencias de cookies (solo si hay analytics). */
  showConsentPreferences?: boolean;
}

const { locale = defaultLocale, showConsentPreferences = false } = Astro.props;

// Textos compartidos desde Keystatic (colección siteCommon)
const commonEntry = await getEntry('siteCommon', locale);
if (!commonEntry) {
  throw new Error(`[siteCommon] No existe la entrada '${locale}' (src/content/common/${locale}.json).`);
}
const common = commonEntry.data;
const links = common.nav.map((item) => ({ ...item, href: localePath(locale, item.href) }));
---

<footer class="site-footer">
  <a class="wordmark footer-wordmark" href={localePath(locale, '/')} aria-label={common.homeLabel}>
    <img
      class="wordmark-logo"
      src={withBase(siteBrand.logoUrl)}
      alt={siteBrand.name}
      width={siteBrand.logoWidth}
      height={siteBrand.logoHeight}
    />
  </a>
  <div class="footer-links">
    {links.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="footer-meta">
    <span>{common.footerMeta}</span>
    {showConsentPreferences && (
      <button type="button" class="footer-consent" data-consent-open>
        {common.consent.preferencesLabel}
      </button>
    )}
  </div>
</footer>

<style>
  .footer-consent {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--paper);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .footer-consent:hover { color: var(--turquoise); }
  .footer-consent:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
