---
// src/layouts/BaseLayout.astro
// Canonical layout para VBK ("Trail Control Room").
// Dark-only por diseño (features.dark_mode === false): sin ThemeToggle ni
// wiring de tema. i18n ES/EN vía rutas con prefijo (features.i18n).
// SEO.astro (inmutable) es el punto de integración de meta tags del harness.

import '@/styles/vbk.css';
import SkipLink from '@/components/layout/SkipLink.astro';
import SEO from '@/components/seo/SEO.astro';
import GTM from '@/components/analytics/GTM.astro';
import GA4 from '@/components/analytics/GA4.astro';
import ConsentBanner from '@/components/analytics/ConsentBanner.astro';
import SiteHeader from '@/components/vbk/SiteHeader.astro';
import SiteFooter from '@/components/vbk/SiteFooter.astro';
import { organizationSchema, websiteSchema, getSiteUrl } from '@/lib/seo';
import { initAnalytics } from '@/lib/analytics';
import { withBase } from '@/utils/url';
import fontDisplayBold from '@/assets/fonts/barlow-condensed-latin-700-normal.woff2?url';
import fontBody from '@/assets/fonts/dm-sans-latin-wght-normal.woff2?url';
import { getEntry } from 'astro:content';
import {
  locales,
  defaultLocale,
  localePath,
  type Locale,
} from '@/i18n/config';

export interface Props {
  title: string;
  description: string;
  /** Path sin prefijo de locale (p. ej. '/evento'). Default '/'. */
  path?: string;
  locale?: Locale;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  locale = defaultLocale,
  ogImage = getSiteUrl('/img/og-default.jpg'),
  noindex = false,
  jsonLd,
} = Astro.props;

// Textos compartidos (header, footer, a11y) desde la colección Keystatic
// `siteCommon` — una entrada por idioma (src/content/common/{locale}.json).
const commonEntry = await getEntry('siteCommon', locale);
if (!commonEntry) {
  throw new Error(`[siteCommon] No existe la entrada '${locale}' (src/content/common/${locale}.json). Créala o edítala en el CMS (Keystatic → Textos compartidos).`);
}
const common = commonEntry.data;

const canonical = getSiteUrl(localePath(locale, path));

// hreflang alternates: misma página en cada locale soportado
const hreflang: Record<string, string> = {};
for (const l of locales) {
  hreflang[l] = getSiteUrl(localePath(l, path));
}

// Analytics IDs from env vars
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
// GTM tiene prioridad: GA4 directo (gtag.js) solo si hay GA4 y NO hay GTM.
const hasAnalytics = Boolean(gtmId || ga4Id);
const useDirectGa4 = Boolean(ga4Id) && !gtmId;

// Base JSON-LD schemas injected on every page
const baseSchemas = [organizationSchema(), websiteSchema()];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...baseSchemas, ...pageSchemas];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <!-- Consent Mode defaults (before analytics); solo si hay GTM o GA4 configurados -->
    {hasAnalytics && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
      </script>
    )}

    <!-- Google Tag Manager (conditional) -->
    {gtmId && <GTM gtmId={gtmId} />}

    <!-- GA4 directo (solo sin GTM; GTM tiene prioridad) -->
    {useDirectGa4 && <GA4 ga4Id={ga4Id} />}

    <!-- SEO component (INMUTABLE — do not modify) -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={allSchemas}
      lang={locale}
      hreflang={hreflang}
    />

    <!-- Tipografía de marca autoalojada (@font-face en vbk.css): preload solo de
         las 2 fuentes críticas del above-the-fold (hero heading + body). -->
    <link rel="preload" as="font" type="font/woff2" href={fontDisplayBold} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontBody} crossorigin />

    <!-- Dimensiones/tipo de la imagen OG por defecto (SEO.astro solo emite og:image) -->
    {ogImage === getSiteUrl('/img/og-default.jpg') && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}

    <slot name="head" />
  </head>
  <body>
    <!-- Consent Banner (solo si hay GTM o GA4; el consent default vive en el <head>) -->
    {hasAnalytics && <ConsentBanner {...common.consent} />}

    <a href="#main-content" class="skip-link">{common.skipToContent}</a>

    <SiteHeader locale={locale} path={path} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter locale={locale} showConsentPreferences={hasAnalytics} />

    <div class="toast" role="status" aria-live="polite" hidden></div>

    <script>
      // Initialize analytics: listens to DOM events and sends to GTM dataLayer
      initAnalytics();
    </script>

    <!-- Comportamientos globales VBK (header scroll, menú móvil, tabs,
         countdown, crossfade, tablero de resultados, scrollspy, animaciones) -->
    <script src="../scripts/vbk.ts"></script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
