# ─────────────────────────────────────────────────────────────────────────────
# Valdivia Bike Fest — variables de entorno. Copia a `.env` (NO se versiona).
# Nunca pongas secretos reales en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL canónica (sitemap, canonicals, OG). Producción: https://valdiviabikefest.cl
PUBLIC_SITE_URL=https://valdiviabikefest.cl

# Idioma por defecto del sitio (ISO 639-1)
PUBLIC_SITE_LANG=es

# ── Analítica (dejar vacío para omitir) ──────────────────────────────────────
# GTM tiene prioridad: si hay PUBLIC_GTM_ID, NO se inyecta gtag.js aunque exista
# PUBLIC_GA4_ID (configura GA4 dentro del contenedor GTM). GA4 directo solo sin GTM.
# Con cualquiera de los dos se activa el banner de consentimiento (Consent Mode v2,
# default 'denied' en <head>) y el botón "Preferencias de cookies" del footer.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=

# ── Contacto ─────────────────────────────────────────────────────────────────
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_MAPS_EMBED_URL=
PUBLIC_CONTACT_ADDRESS=

# ── Redes sociales (vacío = no se renderiza) ─────────────────────────────────
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_INSTAGRAM_HANDLE=

# Endpoint externo del formulario (Formspree, Getform...). Vacío = fallback mailto:
PUBLIC_FORM_ACTION=

# ── Target de build ──────────────────────────────────────────────────────────
# static (default) → GitHub Pages: estático puro, sin adapter ni Keystatic.
# node             → Hostinger Node.js: adapter @astrojs/node + Keystatic Cloud.
# Los scripts `npm run build` y `npm run build:node` ya lo fijan; solo hace
# falta definirlo aquí si ejecutas `astro build` a mano.
DEPLOY_TARGET=static

# Subruta para GitHub Pages (solo target static). En Hostinger (node) se ignora.
# Ej: /valdivia-bikefest-demo (la define el workflow de GitHub Actions).
PUBLIC_BASE_PATH=

# ── Keystatic ────────────────────────────────────────────────────────────────
# true habilita el admin en `astro dev` (equivale a `npm run keystatic`) con
# storage local en http://localhost:4321/keystatic. El target `node` lo activa
# siempre; el target `static` nunca.
ASTRO_ENABLE_KEYSTATIC=false

# Storage del CMS: local | cloud. Si se omite: local en dev, cloud en cualquier
# build. Se incrusta en build time (prefijo PUBLIC_ exigido por Vite/Astro).
PUBLIC_KEYSTATIC_STORAGE=

# Proyecto de Keystatic Cloud con formato "<team>/<project>" (se obtiene en
# https://keystatic.cloud; NO es un secreto). Se incrusta en build time, por lo
# que debe estar definido ANTES de `npm run build:node`.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=valdivia-bike-fest/valdivia-bikefest
